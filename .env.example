# Server Configuration
PORT=3000
NODE_ENV=development

# Database Connection (MongoDB Atlas)
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas details
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/clinic?retryWrites=true&w=majority"

# Authentication & Security
# Generate a strong, unique secret key for JWT session tokens
JWT_SECRET="your_jwt_secret_key_here"

# Cloudinary Media Storage (For medical images, prescriptions, and lab attachments)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Google Gemini AI Integration
GEMINI_API_KEY=""

# Application Host URL (e.g., https://yourdomain.com)
APP_URL=""

# Nodemailer SMTP Email Service (Automated Lab Reports & Prescription Delivery)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER="notifications.hafizclinic@gmail.com"
SMTP_PASS="your_app_specific_password_here"
SMTP_FROM='"Hafiz Clinic & Healthcare System" <notifications.hafizclinic@gmail.com>'
